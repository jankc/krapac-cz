---
import { render } from 'astro:content';
import RemoteImage from '../components/RemoteImage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getAllGalleries,
  getGalleryBySlug,
  getSortedGalleries,
} from '../lib/galleries';

export async function getStaticPaths() {
  const galleries = await getAllGalleries();

  return galleries.map((gallery) => ({
    params: { slug: gallery.slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing gallery slug.');
}

const gallery = await getGalleryBySlug(slug);

if (!gallery) {
  throw new Error(`Unknown gallery slug: ${slug}`);
}

const { Content } = await render(gallery.entry);
const hasText = Boolean(gallery.entry.body?.trim());

const visibleGalleries = await getSortedGalleries();
const currentIndex = gallery.hidden
  ? -1
  : visibleGalleries.findIndex((item) => item.slug === slug);
const nextGallery = gallery.hidden
  ? undefined
  : visibleGalleries[(currentIndex + 1) % visibleGalleries.length];

const total = gallery.images.length;
const pad = (n: number) => String(n).padStart(2, '0');
const photoWord =
  total === 1 ? 'fotografie' : total < 5 ? 'fotografie' : 'fotografií';
const positionPrefix = gallery.hidden ? '' : `${pad(currentIndex + 1)} — `;
const galleryMeta = `${positionPrefix}${total} ${photoWord}`;
---

<BaseLayout
  title={`${gallery.title} | Jan Krapac Photography`}
  description={gallery.description}
  image={gallery.featuredPhotoSrc}
  noindex={gallery.hidden}
>
  <main class="gallery">
    <header class="gallery-head">
      <a class="back" href="/">← Index</a>
      <h1 class="gallery-title display">{gallery.title}</h1>
      <p class="gallery-meta">{galleryMeta}</p>
      {
        hasText && (
          <div class="gallery-text">
            <Content />
          </div>
        )
      }
    </header>

    <div class="gallery-feed">
      {
        gallery.images.map((image, index) => (
          <figure class="gallery-item">
            <a
              href={`/${slug}/${index + 1}/`}
              aria-label={`Otevřít fotografii ${index + 1} z galerie ${gallery.title}`}
            >
              <RemoteImage
                photo={image}
                alt={`${gallery.title} ${index + 1}`}
                widths={[720, 1080, 1600, 2320]}
                sizes="(max-width: 1240px) 94vw, 1160px"
                loading={index < 2 ? 'eager' : 'lazy'}
              />
            </a>
            <figcaption>
              {pad(index + 1)} / {pad(total)}
            </figcaption>
          </figure>
        ))
      }
    </div>

    {
      nextGallery && (
        <nav class="gallery-next" aria-label="Další galerie">
          <a href={`/${nextGallery.slug}/`}>
            <span class="gallery-next-label">Další galerie</span>
            <span class="gallery-next-title display">
              {nextGallery.title} →
            </span>
          </a>
        </nav>
      )
    }
  </main>
</BaseLayout>
