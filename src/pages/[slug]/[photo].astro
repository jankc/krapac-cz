---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RemoteImage from '../../components/RemoteImage.astro';
import { getAllGalleryDetails, type GalleryDetail } from '../../lib/galleries';
import { cdnUrl } from '../../lib/images';

export async function getStaticPaths() {
  const galleries = await getAllGalleryDetails();

  return galleries.flatMap((gallery) =>
    gallery.images.map((_, index) => ({
      params: { slug: gallery.slug, photo: String(index + 1) },
      props: { gallery, index },
    }))
  );
}

interface Props {
  gallery: GalleryDetail;
  index: number;
}

const { gallery, index } = Astro.props;
const image = gallery.images[index];
const total = gallery.images.length;
const pad = (n: number) => String(n).padStart(2, '0');

const prevHref = index > 0 ? `/${gallery.slug}/${index}/` : undefined;
const nextHref =
  index < total - 1 ? `/${gallery.slug}/${index + 2}/` : undefined;
---

<BaseLayout
  title={`${gallery.title} ${pad(index + 1)} | Jan Krapac Photography`}
  description={gallery.description}
  image={cdnUrl(image.path, { width: 1200 })}
  chrome={false}
  noindex={gallery.hidden}
>
  <main class="photo-page">
    <nav class="photo-nav">
      <a class="back" href={`/${gallery.slug}/`} data-back>← {gallery.title}</a>
      <span class="photo-counter">{pad(index + 1)} / {pad(total)}</span>
      <span></span>
    </nav>
    <div class="photo-stage">
      {
        prevHref && (
          <a
            class="photo-side photo-side-prev"
            href={prevHref}
            rel="prev"
            aria-label="Předchozí fotografie"
          >
            ←
          </a>
        )
      }
      <RemoteImage
        photo={image}
        alt={`${gallery.title} ${index + 1}`}
        widths={[1200, 1600, 2000, 2600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      {
        nextHref && (
          <a
            class="photo-side photo-side-next"
            href={nextHref}
            rel="next"
            aria-label="Další fotografie"
          >
            →
          </a>
        )
      }
    </div>
  </main>
</BaseLayout>

<script>
  document.addEventListener('keydown', (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    const target =
      event.key === 'ArrowLeft'
        ? 'a[rel="prev"]'
        : event.key === 'ArrowRight'
          ? 'a[rel="next"]'
          : event.key === 'Escape'
            ? '[data-back]'
            : null;
    if (!target) return;
    const link = document.querySelector<HTMLAnchorElement>(target);
    if (link) window.location.href = link.href;
  });
</script>
