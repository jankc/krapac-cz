---
import '../assets/styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import favicon from '../assets/images/website-icon.png';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: string;
  noindex?: boolean;
  chrome?: boolean;
}

const {
  title = 'Jan Krapac Photography',
  description = 'Selected portfolios by Jan Krapáč.',
  image,
  lang = 'cs',
  noindex = false,
  chrome = true,
} = Astro.props;

const siteUrl = Astro.site;
const canonicalUrl = siteUrl
  ? new URL(Astro.url.pathname, siteUrl).toString()
  : Astro.url.toString();
const ogImageUrl = image
  ? new URL(image, siteUrl ?? Astro.url).toString()
  : undefined;
const twitterCardType = ogImageUrl ? 'summary_large_image' : 'summary';
const ogLocale = lang === 'cs' ? 'cs_CZ' : 'en_US';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={favicon.src} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@125,400..700&family=Fragment+Mono&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jan Krapac Photography" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="twitter:card" content={twitterCardType} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <script defer src="https://umami.unsnapp.com/script.js" data-website-id="05eaa61b-285c-4dba-92cf-9ea9a855e278"></script>
  </head>
  <body>
    {chrome && <Header />}
    <slot />
    {chrome && <Footer />}
  </body>
</html>
